###############################################################################
# Environment variable reference.
#
# Copy to `.env.local` for local development:
#     cp .env.example .env.local
#
# `.env.local` is gitignored. This file is the tracked contract: every variable
# the application reads MUST be documented here and declared in `lib/env.ts`.
# Nothing in this file may contain a real secret.
#
# Where each variable comes from in production:
#   - PORT / HOSTNAME .................. injected by Cloud Run
#   - NEXT_PUBLIC_* .................... baked in at build time by the Docker
#                                        build args in .github/workflows/deploy.yml
#   - everything else .................. set as Cloud Run env vars or, for
#                                        secrets, mounted from Secret Manager
###############################################################################

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------

# Node runtime mode. Set automatically by `next dev` / `next build` / Docker.
# Do not set this by hand in .env.local.
# Values: development | production | test
NODE_ENV=development

# TCP port the server binds to.
# Cloud Run injects this (8080 by default) and the container MUST honour it,
# a hardcoded port is the #1 cause of "container failed to start" deploys.
# Default: 3000 locally, 8080 in the container.
PORT=3000

# Network interface to bind. Must be 0.0.0.0 inside a container, otherwise the
# process is unreachable from outside it. Set to 0.0.0.0 in the Dockerfile.
# Default: 0.0.0.0
HOSTNAME=0.0.0.0

# Minimum severity that gets logged. Anything below is dropped.
# Values: debug | info | warn | error
# Default: info. Use `debug` locally, keep `info` in production.
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Application, public (INLINED INTO THE CLIENT BUNDLE)
#
# WARNING: every NEXT_PUBLIC_* value is embedded in the JavaScript served to
# browsers and is therefore public. Never put a credential behind this prefix.
# These are read at BUILD time, so changing them requires a rebuild, not just a
# Cloud Run env var update.
# -----------------------------------------------------------------------------

# Canonical public origin. Used for metadataBase, canonical URLs, OG images.
# Optional. Cloud Run generates the service URL only after the first deploy, so
# this is not a startup requirement, the app falls back to the value below.
# In CI it is set to the Cloud Run service URL and inlined on the next build.
# Example: https://my-app-abc123-as.a.run.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Display name shown in page titles and structured logs.
NEXT_PUBLIC_APP_NAME=Next.js on Cloud Run

# Build identifier. CI sets this to the commit SHA so /api/health reports
# exactly which revision is serving traffic.
# Default: dev
NEXT_PUBLIC_APP_VERSION=dev

# Base URL of the Playroom rooms API, INCLUDING its /v1 prefix. No trailing
# slash, every path in services/playroom-api.ts is appended to it. Only read
# when NEXT_PUBLIC_PLAYROOM_TRANSPORT is `remote`.
#
# This app serves the API itself, from app/api/v1/, so the default is a
# same-origin path. Change it only to point a build at another deployment.
# Default: /api/v1
NEXT_PUBLIC_PLAYROOM_API_URL=/api/v1

# Where room state lives.
#   local  - rooms are kept in the browser (localStorage). The app is fully
#            playable across tabs on one device, but not across devices. It
#            needs no database, so it is the default for a fresh checkout.
#   remote - rooms come from NEXT_PUBLIC_PLAYROOM_API_URL, stored in Firestore:
#            real multi-device play, with a live event stream and a 2-second
#            poll behind it. Needs a Firestore (the emulator works), see the
#            Google Cloud section below. The deploy workflow builds with this.
# Inlined at build time: changing it on Cloud Run does nothing, you must rebuild.
# Values: local | remote
# Default: local
NEXT_PUBLIC_PLAYROOM_TRANSPORT=local

# -----------------------------------------------------------------------------
# Google Cloud
#
# Not required to run the app locally. Cloud Run populates the identity it needs
# via the attached service account and the metadata server, never ship a key.
# -----------------------------------------------------------------------------

# GCP project that owns Artifact Registry, the Cloud Run service and the
# Firestore database. Also configured as the GCP_PROJECT_ID GitHub Actions
# variable. Required in production.
GCP_PROJECT_ID=

# Machine name of this app. One slug names the Cloud Run service, the runtime
# service account and the Firestore database. Required in production.
APP_SLUG=

# Firestore database the rooms API reads and writes. A NAMED database, never
# "(default)": the runtime service account's access is granted under an IAM
# condition pinned to this exact name. Required in production.
# Defaults to "<APP_SLUG>-db" when left empty.
#
# A database's location is permanent. It cannot be changed or moved.
FIRESTORE_DATABASE_ID=

# Set ONLY by the emulator runner (scripts/run-emulator-tests.sh) or by hand
# for local development against `pnpm db:emulator`. When present, the Firestore
# SDK talks to the emulator and sends no credentials.
#
# Never set this in a deployed environment. It would silently route every
# read and write to a host that does not exist.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8085

# Deployment region, e.g. asia-south1, europe-west1, us-central1.
# Cloud Run, Artifact Registry and Firestore all live here. A cross-region
# read adds tens of milliseconds to every query and bills egress.
GCP_REGION=asia-south1

# Set automatically by the deploy workflow (UTC, ISO-8601). Leave empty locally.
# /api/health renders it in IST so you can confirm a deploy without opening GitHub.
DEPLOYED_AT=

# -----------------------------------------------------------------------------
# Secrets, examples only, uncomment and adapt per project
#
# Never store real secrets in any .env file that is committed. In production,
# create them in Secret Manager and reference them from Cloud Run:
#
#   gcloud secrets create API_KEY --replication-policy=automatic
#   printf '%s' "$VALUE" | gcloud secrets versions add API_KEY --data-file=-
#   gcloud run services update SERVICE --set-secrets=API_KEY=API_KEY:latest
#
# Firestore needs no secret: the runtime service account reaches it through
# Application Default Credentials.
#
# See cloud/environment-variables.md for the full procedure.
# -----------------------------------------------------------------------------

# API_KEY=
# NEXTAUTH_SECRET=
