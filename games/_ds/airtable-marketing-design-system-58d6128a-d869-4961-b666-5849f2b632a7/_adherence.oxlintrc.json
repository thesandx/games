{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/buttons/**",
              "components/forms/**",
              "components/layout/**",
              "components/navigation/**",
              "components/pricing/**",
              "components/signature/**",
              "components/surfaces/**",
              "ui_kits/marketing-site/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Huninn))/i]",
        "message": "Font not provided by the design system. Available: Huninn."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArticleCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:category|title|meta|media|href|style|key|ref|className|style|children)$/]",
        "message": "<ArticleCard> doesn't accept that prop. Declared props: category, title, meta, media, href, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Band'] > JSXAttribute > JSXIdentifier[name!=/^(?:surface|pad|width|style|children|key|ref|className|style|children)$/]",
        "message": "<Band> doesn't accept that prop. Declared props: surface, pad, width, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Band'] > JSXAttribute[name.name='surface'] > Literal[value!=/^(?:canvas|soft|strong|dark|cream)$/]",
        "message": "<Band> surface must be one of 'canvas' | 'soft' | 'strong' | 'dark' | 'cream'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Band'] > JSXAttribute[name.name='pad'] > Literal[value!=/^(?:section|lg|sm|none)$/]",
        "message": "<Band> pad must be one of 'section' | 'lg' | 'sm' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Band'] > JSXAttribute[name.name='width'] > Literal[value!=/^(?:default|narrow)$/]",
        "message": "<Band> width must be one of 'default' | 'narrow'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|pressed|href|icon|iconAfter|style|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, pressed, href, icon, iconAfter, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|pricingPill|legal)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'pricingPill' | 'legal'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<Button> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CalloutCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|body|action|media|style|children|key|ref|className|style|children)$/]",
        "message": "<CalloutCard> doesn't accept that prop. Declared props: title, body, action, media, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='CardGrid'] > JSXAttribute > JSXIdentifier[name!=/^(?:columns|dense|style|children|key|ref|className|style|children)$/]",
        "message": "<CardGrid> doesn't accept that prop. Declared props: columns, dense, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='CtaBand'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|title|body|action|style|key|ref|className|style|children)$/]",
        "message": "<CtaBand> doesn't accept that prop. Declared props: tone, title, body, action, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CtaBand'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<CtaBand> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DemoGridCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:surface|title|caption|height|media|style|children|key|ref|className|style|children)$/]",
        "message": "<DemoGridCard> doesn't accept that prop. Declared props: surface, title, caption, height, media, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='DemoGridCard'] > JSXAttribute[name.name='surface'] > Literal[value!=/^(?:canvas|peach|mint|yellow|mustard|cream)$/]",
        "message": "<DemoGridCard> surface must be one of 'canvas' | 'peach' | 'mint' | 'yellow' | 'mustard' | 'cream'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeatureTab'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|title|body|media|action|key|ref|className|style|children)$/]",
        "message": "<FeatureTab> doesn't accept that prop. Declared props: label, title, body, media, action."
      },
      {
        "selector": "JSXOpeningElement[name.name='FooterColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|links|key|ref|className|style|children)$/]",
        "message": "<FooterColumn> doesn't accept that prop. Declared props: title, links."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeroBand'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|subtitle|actions|note|align|media|style|key|ref|className|style|children)$/]",
        "message": "<HeroBand> doesn't accept that prop. Declared props: eyebrow, title, subtitle, actions, note, align, media, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeroBand'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<HeroBand> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|size|pressed|style|children|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: label, size, pressed, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='LogoStrip'] > JSXAttribute > JSXIdentifier[name!=/^(?:names|label|style|key|ref|className|style|children)$/]",
        "message": "<LogoStrip> doesn't accept that prop. Declared props: names, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MediaPlaceholder'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|ratio|radius|style|key|ref|className|style|children)$/]",
        "message": "<MediaPlaceholder> doesn't accept that prop. Declared props: label, ratio, radius, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PricingComparisonRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|values|header|style|key|ref|className|style|children)$/]",
        "message": "<PricingComparisonRow> doesn't accept that prop. Declared props: label, values, header, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PricingTierCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|price|cadence|blurb|features|cta|featured|onSelect|style|key|ref|className|style|children)$/]",
        "message": "<PricingTierCard> doesn't accept that prop. Declared props: name, price, cadence, blurb, features, cta, featured, onSelect, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stripe'] > JSXAttribute > JSXIdentifier[name!=/^(?:color|width|key|ref|className|style|children)$/]",
        "message": "<Stripe> doesn't accept that prop. Declared props: color, width."
      },
      {
        "selector": "JSXOpeningElement[name.name='SignatureCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|eyebrow|title|body|action|media|style|children|key|ref|className|style|children)$/]",
        "message": "<SignatureCard> doesn't accept that prop. Declared props: tone, eyebrow, title, body, action, media, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='SignatureCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:coral|forest|dark)$/]",
        "message": "<SignatureCard> tone must be one of 'coral' | 'forest' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|focused|invalid|iconBefore|style|key|ref|className|style|children)$/]",
        "message": "<TextInput> doesn't accept that prop. Declared props: label, hint, focused, invalid, iconBefore, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|active|style|children|key|ref|className|style|children)$/]",
        "message": "<TextLink> doesn't accept that prop. Declared props: href, active, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='RailItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|count|key|ref|className|style|children)$/]",
        "message": "<RailItem> doesn't accept that prop. Declared props: id, label, count."
      },
      {
        "selector": "JSXOpeningElement[name.name='TopNavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|menu|key|ref|className|style|children)$/]",
        "message": "<TopNavItem> doesn't accept that prop. Declared props: id, label, menu."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|tone|style|key|ref|className|style|children)$/]",
        "message": "<Wordmark> doesn't accept that prop. Declared props: name, size, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ink|onDark)$/]",
        "message": "<Wordmark> tone must be one of 'ink' | 'onDark'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
